pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        SONAR_PROJECT_KEY = 'Jaswanthkothakonda_aws-devops-learning'
        SONAR_ORGANIZATION = 'jaswanthkothakonda'
        SONAR_SCANNER_JAVA_OPTS = '-Xmx512m'
    }

    stages {
        stage('Checkout Source') {
            steps {
                echo 'Checking out Maven project from GitHub...'
                checkout scm
            }
        }

        stage('Prepare Build Version') {
            steps {
                script {
                    env.MAVEN_REVISION = "1.0.${env.BUILD_NUMBER}"
                    echo "Maven artifact version: ${env.MAVEN_REVISION}"
                }
            }
        }

        stage('Build and Test') {
            steps {
                dir('maven-demo') {
                    sh '''
                        set -eu

                        echo "===== Java Version ====="
                        java -version

                        echo "===== Maven Version ====="
                        mvn -version

                        echo "===== Maven Clean Verify ====="
                        mvn -B -ntp -DforkCount=0 \
                            clean verify \
                            -Drevision="${MAVEN_REVISION}"
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                    withCredentials([
                        string(
                            credentialsId: 'sonarcloud-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        dir('maven-demo') {
                            sh '''
                                set -eu

                                echo "===== SonarQube Cloud Analysis ====="
                                echo "Scanner heap limit: 512 MB"

                                mvn -B -ntp \
                                    -Drevision="${MAVEN_REVISION}" \
                                    org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar \
                                    -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                    -Dsonar.organization="${SONAR_ORGANIZATION}"
                            '''
                        }
                    }
                }
            }
        }

        stage('Verify JAR Artifact') {
            steps {
                sh '''
                    set -eu

                    JAR_FILE="maven-demo/target/maven-demo-${MAVEN_REVISION}.jar"

                    test -f "$JAR_FILE"
                    jar tf "$JAR_FILE" | grep -q 'com/beasteats/App.class'

                    echo "Executable JAR verified: $JAR_FILE"
                '''
            }
        }
    }

    post {
        always {
            junit(
                testResults: 'maven-demo/target/surefire-reports/TEST-*.xml',
                allowEmptyResults: true
            )

            archiveArtifacts(
                artifacts: 'maven-demo/target/maven-demo-*.jar',
                fingerprint: true,
                allowEmptyArchive: true
            )
        }

        success {
            echo "Maven CI and SonarQube analysis completed. Version: ${env.MAVEN_REVISION}"
        }

        failure {
            echo 'Pipeline failed. Check the first failing stage in Console Output.'
        }
    }
}
