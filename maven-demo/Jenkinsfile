pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Checkout Source') {
            steps {
                echo 'Checking out Maven project from GitHub...'
                checkout scm
            }
        }

        stage('Prepare Build Version') {
            steps {
                script {
                    env.MAVEN_REVISION = "1.0.${env.BUILD_NUMBER}"
                    echo "Maven artifact version: ${env.MAVEN_REVISION}"
                }
            }
        }

        stage('Build and Test') {
            steps {
                dir('maven-demo') {
                    sh '''
                        set -eu

                        echo "===== Java Version ====="
                        java -version

                        echo "===== Maven Version ====="
                        mvn -version

                        echo "===== Maven Clean Verify ====="
                        mvn -B -ntp -DforkCount=0 clean verify \
                            -Drevision="${MAVEN_REVISION}"
                    '''
                }
            }
        }

        stage('Verify JAR Artifact') {
            steps {
                sh '''
                    set -eu

                    JAR_FILE="maven-demo/target/maven-demo-${MAVEN_REVISION}.jar"

                    test -f "$JAR_FILE"
                    jar tf "$JAR_FILE" | grep -q 'com/beasteats/App.class'

                    echo "Executable JAR verified: $JAR_FILE"
                '''
            }
        }
    }

    post {
        always {
            junit(
                testResults: 'maven-demo/target/surefire-reports/TEST-*.xml',
                allowEmptyResults: true
            )
        }

        success {
            script {
                archiveArtifacts(
                    artifacts: "maven-demo/target/maven-demo-${env.MAVEN_REVISION}.jar",
                    fingerprint: true
                )
            }

            echo "Maven CI pipeline completed successfully. Version: ${env.MAVEN_REVISION}"
        }

        failure {
            echo 'Maven CI pipeline failed. Review the console log.'
        }

        aborted {
            echo 'Maven CI pipeline was aborted.'
        }
    }
}
